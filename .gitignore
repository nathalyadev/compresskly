# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage
**/TestResults

# next.js
front/.next/
front/out/

# production
**/build
**/bin
**/obj

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
front/next-env.d.ts

# .NET / Visual Studio
.vs/
*.user
*.suo
*.db
*.db-shm
*.db-wal

# local uploads / storage content
api/storage/original/*
!api/storage/original/.gitkeep
api/storage/compressed/*
!api/storage/compressed/.gitkeep
/tmp
/uploads
