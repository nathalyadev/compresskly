{
  "ConnectionStrings": {
    "Default": "Data Source=compresskly.db"
  },
  "Upload": {
    "MaxFileSizeMb": 500
  },
  "Storage": {
    "RootPath": "../../storage",
    "OriginalFolder": "original",
    "CompressedFolder": "compressed"
  },
  "Ffmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
